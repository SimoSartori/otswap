@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The meshsearch otswap was built against: any patch release of its minor
# version.
find_dependency(meshsearch @OTSWAP_MESHSEARCH_VERSION@ CONFIG)

# cfitsio, found on this machine by the module installed beside this file;
# CFITSIO_ROOT, and ZLIB_ROOT for a static cfitsio, are honoured.
list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(CFITSIO)
list(REMOVE_AT CMAKE_MODULE_PATH 0)

# OpenMP, when otswap was built with it. AppleClang needs to be pointed at a
# libomp: Homebrew's, unless OpenMP_ROOT is set, as otswap's own build does.
if (@OTSWAP_WITH_OPENMP@)
  if (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND
      NOT DEFINED OpenMP_ROOT AND NOT DEFINED ENV{OpenMP_ROOT})
    foreach (candidate /opt/homebrew/opt/libomp /usr/local/opt/libomp)
      if (EXISTS ${candidate}/include/omp.h)
        set(OpenMP_ROOT ${candidate})
        break()
      endif()
    endforeach()
  endif()
  find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/otswapTargets.cmake")

check_required_components(otswap)
